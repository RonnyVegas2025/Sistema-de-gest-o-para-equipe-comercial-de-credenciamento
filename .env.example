# ---------------------------------------------------------------------------
# CRM Comercial de Credenciamento Vegas — variáveis de ambiente
#
#   cp .env.example .env.local
#
# .env.local NÃO vai para o Git (.gitignore). Este arquivo é o template: só
# nomes, comentários e valores de exemplo — nenhum segredo real entra aqui.
#
# As variáveis vivem em TRÊS lugares que não se comunicam entre si. Preencher um
# não preenche os outros. Ver README, seção "Variáveis de ambiente".
#   1. .env.local            máquina do desenvolvedor
#   2. Vercel                Production, Preview e Development, separadamente
#   3. GitHub Actions        Secrets do repositório, para o CI
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase — aplicação
# ---------------------------------------------------------------------------

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL="https://oywwcwkkwsrgzgkegifn.supabase.co"

# Chave pública (anon). Vai para o navegador — é pública por desenho.
# A proteção do dado vem da RLS, nunca do sigilo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Chave de serviço. IGNORA A RLS COMPLETAMENTE.
#
# NÃO preencher aqui e NÃO definir no .env.local. No CRM ela existe em um único
# lugar: os secrets da Edge Function (`supabase secrets set`), onde a função
# admin-create-user a lê. Nunca no runtime do Next, nunca com prefixo
# NEXT_PUBLIC_, nunca em componente client.
#
# O nome fica declarado aqui só para que ninguém o reintroduza por engano no
# lugar errado. O CI falha o build se a string aparecer em .next/static.
# SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação neste ambiente. Tem UM ÚNICO consumidor: o redirectTo
# do e-mail de recuperação de senha, em src/lib/auth/actions.ts. O
# /auth/callback usa o `origin` do próprio request, não esta variável — o
# retorno depois da troca se autocorrige em qualquer ambiente.
#
#   local:     http://localhost:3000
#   produção:  https://sistema-de-gest-o-para-equipe-comer.vercel.app
#   preview:   a URL de PRODUÇÃO, de propósito
#
# Preview recebe a URL de produção porque a URL de preview muda a cada deploy e
# nenhum valor fixo estaria certo. Consequência, registrada em vez de descoberta
# depois: pedir recuperação de senha a partir de um preview manda o e-mail
# apontando para produção. Recuperar senha em preview não é caso de uso.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase CLI — migrations e geração de tipos
#
# Só na máquina do desenvolvedor. Não vão para a Vercel: nenhum código de
# runtime lê estas variáveis.
# ---------------------------------------------------------------------------

# Referência do projeto (o subdomínio da Project URL). Usada por `db:link`.
SUPABASE_PROJECT_REF=""

# Token de acesso pessoal do CLI: https://supabase.com/dashboard/account/tokens
# É credencial de conta, não do projeto. Não é a service role.
SUPABASE_ACCESS_TOKEN=""

# Senha do banco do projeto (Project Settings > Database). Serve para acesso
# direto ao Postgres; NÃO é usada por `db push`, que não existe neste projeto
# (D-031 — migrations são aplicadas pelo SQL Editor). Também não é a service
# role.
SUPABASE_DB_PASSWORD=""

# ---------------------------------------------------------------------------
# Testes de RLS — apenas GitHub Actions Secrets
#
# Apontam para um projeto Supabase DESCARTÁVEL de teste, nunca para produção.
# O workflow rls-integration.yml falha alto se SUPABASE_TEST_URL faltar.
# Os usuários são semeados pelo gate de cinco usuários da etapa 9.
# ---------------------------------------------------------------------------

# SUPABASE_TEST_URL=
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_USER_EMAIL=
# SUPABASE_TEST_USER_PASSWORD=
# SUPABASE_TEST_ADMIN_EMAIL=
# SUPABASE_TEST_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Consulta de CNPJ — vazias até A-001
#
# O fornecedor ainda não foi escolhido (decisão em aberto A-001, Sprint 2). A
# integração fica desacoplada atrás de uma interface própria (D-008): trocar de
# fornecedor é trocar de implementação, não de chamador.
#
# Ficam declaradas e comentadas de propósito — o nome existe, o valor não.
# ---------------------------------------------------------------------------

# CNPJ_PROVIDER=
# CNPJ_API_URL=
# CNPJ_API_KEY=

# ---------------------------------------------------------------------------
# Playwright — ponta a ponta, apenas local
# ---------------------------------------------------------------------------

# PLAYWRIGHT_BASE_URL="http://localhost:3000"
# E2E_EMAIL=
# E2E_PASSWORD=
